# Isolated local test contour — NEVER real patient data.
# Copy to .env.test (scripts/test-up.ps1 does this automatically).
# Docker services use the compose variables below; the API/Web host processes
# use the API_* block. The project name is `medicare-test`, so volumes and
# networks are separate from the development stack.

# ---- docker compose (infrastructure only) ----
POSTGRES_DB=medicare_test
POSTGRES_USER=medicare_test
POSTGRES_PASSWORD=test-only-postgres-password
POSTGRES_PORT=55432
KEYCLOAK_PORT=8180
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101
CLAMAV_HOST_PORT=3410
LIVEKIT_HTTP_PORT=7980
LIVEKIT_TCP_PORT=7981
LIVEKIT_UDP_PORT=7982

# ---- API/Web on the host ----
API_PORT=4100
DATABASE_URL=postgresql://medicare_test:test-only-postgres-password@127.0.0.1:55432/medicare_test
OIDC_ISSUER_URL=http://localhost:8180/realms/medicare
OIDC_JWKS_URL=http://localhost:8180/realms/medicare/protocol/openid-connect/certs
OIDC_AUDIENCE=medicare-api
DEPLOYMENT_COUNTRY=RU
DEFAULT_LOCALE=ru
DEFAULT_TIMEZONE=Europe/Moscow
S3_REGION=us-east-1
S3_BUCKET_MEDICAL=medical-documents
S3_ENDPOINT=http://127.0.0.1:9100
S3_ACCESS_KEY=medicare-test
S3_SECRET_KEY=test-only-minio-secret
S3_FORCE_PATH_STYLE=true
RATE_LIMIT_ENABLED=true
REQUIRE_PRIVILEGED_MFA=false
PAYMENT_PROVIDER=development
PAYMENT_DEV_WEBHOOK_SECRET=test-only-webhook-secret
FISCAL_RECEIPT_WORKER_ENABLED=false
RETENTION_WORKER_ENABLED=false
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4100
