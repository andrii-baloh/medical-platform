# Shared/local development
DEPLOYMENT_COUNTRY=XX
DEFAULT_LOCALE=ru
DEFAULT_CURRENCY=USD
DEFAULT_TIMEZONE=UTC

# PostgreSQL
DATABASE_URL=postgresql://medicare:medicare@localhost:5432/medicare

# OIDC / Keycloak
OIDC_ISSUER_URL=http://localhost:8080/realms/medicare
OIDC_JWKS_URL=http://localhost:8080/realms/medicare/protocol/openid-connect/certs
OIDC_AUDIENCE=medicare-api

# S3-compatible object storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=local
S3_BUCKET_MEDICAL=medical-documents
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123456
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300

# API
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# Web / Auth.js
NEXT_PUBLIC_APP_URL=http://localhost:3000
MEDICARE_API_URL=http://localhost:4000
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
AUTH_KEYCLOAK_ID=medicare-web
AUTH_KEYCLOAK_SECRET=replace-with-local-dev-secret
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/medicare
