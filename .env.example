# MediCare 0.13 local Docker development only
# Copy to .env and change values before using outside a local throwaway environment.

# PostgreSQL
POSTGRES_DB=medicare
POSTGRES_USER=medicare
POSTGRES_PASSWORD=local-dev-postgres-change-me
POSTGRES_PORT=5432
KEYCLOAK_DB=keycloak

# Keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local-dev-keycloak-admin-change-me
KEYCLOAK_DB_USER=medicare
KEYCLOAK_DB_PASSWORD=local-dev-postgres-change-me
AUTH_KEYCLOAK_ID=medicare-web
AUTH_KEYCLOAK_SECRET=local-dev-medicare-web-secret
AUTH_KEYCLOAK_ISSUER=http://host.docker.internal:8080/realms/medicare
AUTH_KEYCLOAK_AUTHORIZATION_URL=http://host.docker.internal:8080/realms/medicare/protocol/openid-connect/auth
AUTH_KEYCLOAK_TOKEN_URL=http://keycloak:8080/realms/medicare/protocol/openid-connect/token
AUTH_KEYCLOAK_USERINFO_URL=http://keycloak:8080/realms/medicare/protocol/openid-connect/userinfo
OIDC_ISSUER_URL=http://host.docker.internal:8080/realms/medicare
OIDC_JWKS_URL=http://keycloak:8080/realms/medicare/protocol/openid-connect/certs
OIDC_AUDIENCE=medicare-api
AUTH_SECRET=local-dev-nextauth-secret-change-me-32chars-minimum

# API / Web
API_PORT=4000
WEB_PORT=3000
MEDICARE_API_URL=http://api:4000
CORS_ORIGINS=http://localhost:3000,http://host.docker.internal:3000
DEPLOYMENT_COUNTRY=DE
DEFAULT_LOCALE=ru
DEFAULT_TIMEZONE=Europe/Berlin
APP_VERSION=0.13.0
TRUST_PROXY=false
REQUIRE_PRIVILEGED_MFA=false

# MinIO / S3
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=medicare-root
MINIO_ROOT_PASSWORD=local-dev-minio-root-change-me
S3_BUCKET_MEDICAL=medical-documents
S3_ACCESS_KEY=medicare-app
S3_SECRET_KEY=local-dev-minio-app-change-me
S3_ENDPOINT=http://host.docker.internal:9000
S3_REGION=local
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300

# ClamAV
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_HOST_PORT=3310
DOCUMENT_SCAN_PROVIDER=clamav
DOCUMENT_SCAN_WORKER_ENABLED=true

# LiveKit
LIVEKIT_HTTP_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=local-dev-livekit-secret-change-me
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
VIDEO_PROVIDER=livekit

# Development providers/workers
PAYMENT_PROVIDER=development
PAYMENT_DEV_WEBHOOK_SECRET=local-dev-payment-webhook-secret
NOTIFICATION_EMAIL_PROVIDER=development
NOTIFICATION_DELIVERY_WORKER_ENABLED=false
OUTBOX_WORKER_ENABLED=true
