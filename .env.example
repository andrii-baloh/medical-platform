# MediCare local architecture template
# Copy to .env for local development. Never commit real production secrets.
APP_VERSION=0.13.0
DEPLOYMENT_COUNTRY=XX
DEFAULT_LOCALE=ru
DEFAULT_CURRENCY=USD
DEFAULT_TIMEZONE=Europe/Berlin

# PostgreSQL / Docker
POSTGRES_DB=medicare
POSTGRES_USER=medicare
POSTGRES_PASSWORD=replace-with-local-db-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://medicare:replace-with-local-db-password@localhost:5432/medicare

# Keycloak infrastructure
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-local-keycloak-admin-password

# OIDC consumed by the API
OIDC_ISSUER_URL=http://localhost:8080/realms/medicare
OIDC_JWKS_URL=http://localhost:8080/realms/medicare/protocol/openid-connect/certs
OIDC_AUDIENCE=medicare-api

# Privileged authentication
# Keep false for the local fixture until its realm flow is configured for MFA.
REQUIRE_PRIVILEGED_MFA=false
PRIVILEGED_MFA_METHODS=mfa,otp,totp,webauthn
PRIVILEGED_MFA_ACR_VALUES=

# Per-process abuse-control safety net
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_READ_MAX=240
RATE_LIMIT_WRITE_MAX=60
TRUST_PROXY=false

# MinIO infrastructure
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=replace-with-local-minio-root-password

# S3 application credentials
# These are created by minio-init and receive only the medicare-medical policy.
S3_ENDPOINT=http://localhost:9000
S3_REGION=local
S3_BUCKET_MEDICAL=medical-documents
S3_ACCESS_KEY=medicare-app
S3_SECRET_KEY=replace-with-local-minio-app-password
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300

# API
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# LiveKit
VIDEO_PROVIDER=livekit
VIDEO_TOKEN_TTL_SECONDS=900
VIDEO_JOIN_EARLY_MINUTES=15
VIDEO_JOIN_AFTER_START_MINUTES=120
LIVEKIT_SIGNAL_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace-with-local-livekit-secret

# Transactional outbox
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_CLAIM_TTL_SECONDS=120

# Payments
# Development provider never moves real money.
PAYMENT_PROVIDER=development
PAYMENT_DEV_WEBHOOK_SECRET=replace-with-local-dev-webhook-secret

# Outbound notifications
NOTIFICATION_EMAIL_PROVIDER=development
NOTIFICATION_DELIVERY_WORKER_ENABLED=false
NOTIFICATION_DELIVERY_POLL_INTERVAL_MS=5000
NOTIFICATION_DELIVERY_BATCH_SIZE=20
NOTIFICATION_DELIVERY_MAX_ATTEMPTS=8
NOTIFICATION_DELIVERY_CLAIM_TTL_SECONDS=120

# Document security / ClamAV
# Use clamav with the Docker stack. development-pass performs no malware detection.
DOCUMENT_SCAN_PROVIDER=clamav
DOCUMENT_SCAN_WORKER_ENABLED=true
DOCUMENT_SCAN_POLL_INTERVAL_MS=5000
DOCUMENT_SCAN_BATCH_SIZE=10
DOCUMENT_SCAN_MAX_ATTEMPTS=5
DOCUMENT_SCAN_CLAIM_TTL_SECONDS=180
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_SCAN_TIMEOUT_MS=90000
CLAMAV_MAX_STREAM_BYTES=26214400

# Web / Auth.js
NEXT_PUBLIC_APP_URL=http://localhost:3000
MEDICARE_API_URL=http://localhost:4000
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
AUTH_KEYCLOAK_ID=medicare-web
AUTH_KEYCLOAK_SECRET=replace-with-local-dev-secret
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/medicare

# Local-only Keycloak fixture accounts imported by infra/keycloak/realm-export.json:
# doctor@medicare.local / Doctor123!
# patient@medicare.local / Patient123!
# admin@medicare.local / Admin123!
