{
  "realm": "medicare",
  "enabled": true,
  "displayName": "MediCare Local Development",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "roles": {
    "realm": [
      { "name": "patient", "description": "Patient role" },
      { "name": "doctor", "description": "Verified doctor role" },
      { "name": "admin", "description": "Administrative role" }
    ]
  },
  "clients": [
    {
      "clientId": "medicare-api",
      "name": "MediCare API audience",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "medicare-web",
      "name": "MediCare Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "local-dev-medicare-web-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://host.docker.internal:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://host.docker.internal:3000"
      ],
      "protocolMappers": [
        {
          "name": "medicare-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "medicare-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "55555555-5555-5555-5555-555555555555",
      "username": "doctor@medicare.local",
      "email": "doctor@medicare.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Анна",
      "lastName": "Волкова",
      "realmRoles": ["doctor", "patient"],
      "credentials": [
        { "type": "password", "value": "Doctor123!", "temporary": false }
      ]
    },
    {
      "id": "66666666-6666-6666-6666-666666666666",
      "username": "patient@medicare.local",
      "email": "patient@medicare.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Ирина",
      "lastName": "Соколова",
      "realmRoles": ["patient"],
      "credentials": [
        { "type": "password", "value": "Patient123!", "temporary": false }
      ]
    },
    {
      "id": "77777777-7777-7777-7777-777777777777",
      "username": "admin@medicare.local",
      "email": "admin@medicare.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Local",
      "lastName": "Admin",
      "realmRoles": ["admin", "patient"],
      "credentials": [
        { "type": "password", "value": "Admin123!", "temporary": false }
      ]
    }
  ]
}
