{
  "realm": "medicare",
  "enabled": true,
  "displayName": "MediCare",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "sslRequired": "external",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "failureFactor": 5,
  "roles": {
    "realm": [
      {
        "name": "patient",
        "description": "Patient"
      },
      {
        "name": "doctor",
        "description": "Verified doctor"
      },
      {
        "name": "admin",
        "description": "Platform administrator"
      }
    ]
  },
  "defaultRoles": [
    "patient"
  ],
  "clients": [
    {
      "clientId": "medicare-api",
      "name": "MediCare API audience",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "medicare-web",
      "name": "MediCare Web",
      "enabled": true,
      "publicClient": false,
      "secret": "replace-with-local-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/api/auth/callback/keycloak"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "medicare-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "medicare-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "55555555-5555-5555-5555-555555555555",
      "username": "doctor@medicare.local",
      "email": "doctor@medicare.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Анна",
      "lastName": "Волкова",
      "credentials": [
        {
          "type": "password",
          "value": "Doctor123!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "doctor"
      ]
    },
    {
      "id": "66666666-6666-6666-6666-666666666666",
      "username": "patient@medicare.local",
      "email": "patient@medicare.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Ирина",
      "lastName": "Соколова",
      "credentials": [
        {
          "type": "password",
          "value": "Patient123!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "patient"
      ]
    }
  ]
}
