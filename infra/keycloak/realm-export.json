{
  "realm": "medicare",
  "enabled": true,
  "displayName": "MediCare",
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "maxFailureWaitSeconds": 900,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "internationalizationEnabled": true,
  "supportedLocales": ["ru", "de", "en"],
  "defaultLocale": "ru",
  "roles": {
    "realm": [
      { "name": "patient", "description": "Patient" },
      { "name": "doctor", "description": "Verified doctor" },
      { "name": "admin", "description": "Platform administrator" }
    ]
  },
  "defaultRoles": ["patient"],
  "clients": [
    {
      "clientId": "medicare-api",
      "name": "MediCare API audience",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "medicare-web",
      "name": "MediCare Web",
      "enabled": true,
      "publicClient": false,
      "secret": "replace-with-local-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/api/auth/callback/keycloak",
        "http://127.0.0.1:3000/api/auth/callback/keycloak"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://127.0.0.1:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "medicare-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "medicare-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "55555555-5555-5555-5555-555555555555",
      "username": "doctor@medicare.local",
      "email": "doctor@medicare.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Анна",
      "lastName": "Волкова",
      "credentials": [
        { "type": "password", "value": "Doctor123!", "temporary": false }
      ],
      "realmRoles": ["doctor"]
    },
    {
      "id": "66666666-6666-6666-6666-666666666666",
      "username": "patient@medicare.local",
      "email": "patient@medicare.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Ирина",
      "lastName": "Соколова",
      "credentials": [
        { "type": "password", "value": "Patient123!", "temporary": false }
      ],
      "realmRoles": ["patient"]
    },
    {
      "id": "77777777-7777-7777-7777-777777777777",
      "username": "admin@medicare.local",
      "email": "admin@medicare.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Local",
      "lastName": "Admin",
      "credentials": [
        { "type": "password", "value": "Admin123!", "temporary": false }
      ],
      "realmRoles": ["admin"]
    }
  ]
}
